#include <AccelStepper.h>
#include <MultiStepper.h>
#include <stdint.h>
#include "TouchScreen.h"

AccelStepper stepperA(1, 10, 11);
AccelStepper stepperB(1, 8, 9);
AccelStepper stepperC(1, 3, 4);

MultiStepper steppers;
const int ENA = 5;
// Velocidad y aceleración
const float MAX_SPEED = 500.0;
const float ACCELERATION = 1000.0;
//#define YP A1
//#define XM A2
//#define YM 7
//#define XP 6
#define MINPRESSURE 50
#define MAXPRESSURE 1000
TouchScreen ts = TouchScreen(A1, A0, A3, A2, 620);
double Xoffset = 500; 
double Yoffset = 500;  

long target[3] = {0, 0, 0};
int cuadranteActual = -1;
int cuadranteAnterior = -1;
long Homee[3] = {0,0,0};  

void setup() {

    Serial.begin(115200);

    stepperA.setMaxSpeed(MAX_SPEED);
    stepperB.setMaxSpeed(MAX_SPEED);
    stepperC.setMaxSpeed(MAX_SPEED);

    stepperA.setAcceleration(ACCELERATION);
    stepperB.setAcceleration(ACCELERATION);
    stepperC.setAcceleration(ACCELERATION);

    stepperA.setPinsInverted(false, false, false);
    stepperB.setPinsInverted(false, false, false);
    stepperC.setPinsInverted(true, false, false);

    steppers.addStepper(stepperA);
    steppers.addStepper(stepperB);
    steppers.addStepper(stepperC);

    pinMode(ENA, OUTPUT);
    digitalWrite(ENA, LOW);

    Serial.println("Sistema iniciado");
    delay(1000);
}
void loop() {
    TSPoint p = ts.getPoint();

    if (p.z > MINPRESSURE && p.z < MAXPRESSURE) {
        if (p.x < 500 && p.y < 500) {cuadranteActual = 0;}
        else if (p.x < 500 && p.y >= 500) {cuadranteActual = 1;}
        else if (p.x >= 500 && p.y < 500) {cuadranteActual = 2;}
        else {cuadranteActual = 3;}

        if (cuadranteActual != cuadranteAnterior) {
            cuadranteAnterior = cuadranteActual;
            switch (cuadranteActual) {
                case 0:
                    target[0] = 90;
                    target[1] = 90;
                    target[2] = 90;
                    break;
                case 1:
                    target[0] = 100;
                    target[1] = 100;
                    target[2] = 100;
                    break;
                case 2:
                    target[0] = 150;
                    target[1] = 150;
                    target[2] = 150;
                    break;
                case 3:
                    target[0] = 180;
                    target[1] = 180;
                    target[2] = 180;
                    break;
            }
            steppers.moveTo(target);
        }
    }
    steppers.run();
}
