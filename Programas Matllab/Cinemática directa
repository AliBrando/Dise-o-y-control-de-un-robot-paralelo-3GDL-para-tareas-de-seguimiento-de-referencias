4^2*t3^2 - h13^2*h24^2 - 4*h13^2*h24*h26*t3^3 - 4*h13^2*h24*h26*t3 + 4*h13^2*h25^2*t3^2 - 4*h13^2*h26^2*t3^2 - 2*h13*h15*h21*h24*t3^4 - 4*h13*h15*h21*h24*t3^2 - 2*h13*h15*h21*h24 - 4*h13*h15*h21*h26*t3^3 - 4*h13*h15*h21*h26*t3 + 2*h13*h15*h23*h24*t3^4 - 2*h13*h15*h23*h24 + 4*h13*h15*h23*h26*t3^3 - 4*h13*h15*h23*h26*t3 + h15^2*h20^2*t3^4 + 2*h15^2*h20^2*t3^2 + h15^2*h20^2 - 2*h15^2*h20*h22*t3^4 + 2*h15^2*h20*h22 + 4*h15^2*h20*h25*t3^3 + 4*h15^2*h20*h25*t3 - h15^2*h21^2*t3^4 - 2*h15^2*h21^2*t3^2 - h15^2*h21^2 + 2*h15^2*h21*h23*t3^4 - 2*h15^2*h21*h23 + h15^2*h22^2*t3^4 - 2*h15^2*h22^2*t3^2 + h15^2*h22^2 - 4*h15^2*h22*h25*t3^3 + 4*h15^2*h22*h25*t3 - h15^2*h23^2*t3^4 + 2*h15^2*h23^2*t3^2 - h15^2*h23^2 + 4*h15^2*h25^2*t3^2;

%% ============================================================
%  COEFICIENTES c0,c1,c2 (metodo de la tangente del angulo medio, ec. 3.35)
c2=2*h34*t3 + h30*(t3^2 + 1) - h31*(t3^2 - 1) + h32*(t3^2 + 1) - h33*(t3^2 - 1);
c1=4*h36*t3 + 2*h35*(t3^2 + 1);
c0=2*h34*t3 + h30*(t3^2 + 1) - h31*(t3^2 - 1) - h32*(t3^2 + 1) + h33*(t3^2 - 1);

%% ============================================================
%  POLINOMIO H (ec. 3.37)
%  ============================================================
H=a4*(a4*c0^4+c1*(-a3*c0^3+c1*(a2*c0^2-a1*c0*c1+a0*c1^2)))+c2*(c0^3*(a3^2-2*a2*a4)+(c0^2*c1)*(-a2*a3+3*a1*a4)+(c0*c1^2)*(a1*a3-4*a0*a4)-a0*a3*c1^3)+c2^2*(c0^2*(a2^2-2*a1*a3+2*a0*a4)+c0*c1*(-a1*a2+3*a0*a3)+a0*a2*c1^2)+c2^3*(c0*(a1^2-2*a0*a2)-a0*a1*c1)+a0^2*c2^4;

tone=(a4*c0*c1^2-c0*(a4*c0+a3*c1)*c2+a2*c0*c2^2-a0*c2^3)/(-a4*c1^3+c1*(2*a4*c0+a3*c1)*c2-(a3*c0+a2*c1)*c2^2+ a1*c2^3);

ssigma=(f12*f20-f10*f22)/(f11*f22-f12*f21);
csigma=(f10*f21-f11*f20)/(f11*f22-f12*f21);

%% ============================================================
%  RAICES DE H(t3) (grado 16)

H_exp = expand(H);
