coefsH = double(coefsH_sym);

raices_t3 = roots(coefsH);
n_raices = length(raices_t3);

%% ============================================================
%  calcular la pose completa
%  ============================================================
tol_real = 1e-6;    
resultados = [];    

for i = 1:n_raices
    t3Ri = raices_t3(i);
    t3Ri = real(t3Ri);

    try
        t1Ri = double(subs(tone, t3, t3Ri));
        if abs(imag(t1Ri)) > tol_real  %filtro reales
            continue;
        end        
        t1Ri = real(t1Ri);
        
        if t1Ri < 0
            phi1_i = -pi - (2*atan(t1Ri));
            phi3_i = 2*atan(t3Ri);
            t11_i  = tan(phi1_i/2);
            csig_i = double(subs(csigma, [t3, t1], [t3Ri, t11_i]));
            ssig_i = double(subs(ssigma, [t3, t1], [t3Ri, t11_i])); 
            csig_i = min(max(real(csig_i), -1), 1);   
            phi2_i = -acos(csig_i);            
        else
            phi1_i = pi - (2*atan(t1Ri));
            phi3_i = 2*atan(t3Ri);
            t11_i  = tan(phi1_i/2);
            csig_i = double(subs(csigma, [t3, t1], [t3Ri, t11_i]));
            ssig_i = double(subs(ssigma, [t3, t1], [t3Ri, t11_i]));  
            csig_i = min(max(real(csig_i), -1), 1);   
            phi2_i = acos(csig_i);            
        end    
        % acos valido [-1,1]; si se sale, la raiz no es fisica
        if abs(imag(csig_i)) > tol_real || abs(real(csig_i)) > 1 + 1e-4
            continue;
        end

    catch
        continue;   % division entre cero u otra raiz numericamente invalida
    end
    %% ============================================================
    %  SOLUCION ANGULARES   
        r1 = b + l1*cos(th1) + l2*cos(phi1_i);
        z1 = l1*sin(th1) + l2*sin(phi1_i);
        O1 = [r1*cos(alfa1); r1*sin(alfa1); z1];
 
        r2 = b + l1*cos(th2) + l2*cos(phi2_i);
        z2 = l1*sin(th2) + l2*sin(phi2_i);
        O2 = [r2*cos(alfa2); r2*sin(alfa2); z2];
 
        r3 = b + l1*cos(th3) + l2*cos(phi3_i);
        z3 = l1*sin(th3) + l2*sin(phi3_i);
        O3 = [r3*cos(alfa3); r3*sin(alfa3); z3];
 
        Tc = (O1 + O2 + O3)/3;
 
        P1 = p*[cos(alfa1); sin(alfa1); 0];
        P2 = p*[cos(alfa2); sin(alfa2); 0];
        P3 = p*[cos(alfa3); sin(alfa3); 0];
 
        Hm = P1*(O1-Tc)' + P2*(O2-Tc)' + P3*(O3-Tc)';
        [U,~,V] = svd(Hm);
        Rm = V*U';
        if det(Rm) < 0
            V(:,3) = -V(:,3);
            Rm = V*U';
        end
        comprobacion1=norm(O2-O1);
        comprobacion2=norm(O3-O1);
        comprobacion3=norm(O3-O2);
        Ay_i = asin(min(max(Rm(1,3),-1),1));
        Ax_i = atan2(-Rm(2,3), Rm(3,3));
        Az_i = atan2(-Rm(1,2), Rm(1,1));    
        resultados = [resultados; t3Ri, rad2deg(phi1_i), rad2deg(phi2_i), rad2deg(phi3_i), Tc(3), rad2deg(Ax_i), rad2deg(Ay_i), rad2deg(Az_i), comprobacion1,comprobacion2,comprobacion3];     
end
%% ============================================================
%  LAS SOLUCIONES FISICAS ENCONTRADAS
if isempty(resultados)
    warning('Ninguna raiz produjo una solucion fisica (real) valida.');
else
    tabla = array2table(resultados, 'VariableNames', ...
        {'t3','phi1','phi2','phi3','Z','Roll_X', 'Pitch_Y', 'Yaw_Z', 'comp1','comp2', 'comp3'});
    fprintf('\n=== SOLUCIONES FISICAS VALIDAS: %d de %d raices totales ===\n', ...
