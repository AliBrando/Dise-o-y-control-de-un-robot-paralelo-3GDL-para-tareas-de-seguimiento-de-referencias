clear; clc; close all;

%% ---------------- Parametros geometricos ----------------
p  = 55;
b  = 50;
l1 = 45;
l2 = 75;
Zin_nominal = 75;

alfa = deg2rad([0 120 240]);

%% ---------------- Limites reales de tus motores (REVISA ESTO) ----------
theta_min_deg = 0;   
theta_max_deg = 360;   

%% ---------------- Malla de busqueda ----------
roll_range  = deg2rad(-25:1:25);
pitch_range = deg2rad(-25:1:25);
z_range     = (Zin_nominal-60):1:(Zin_nominal+45);

[Ax, Ay, Zin] = ndgrid(roll_range, pitch_range, z_range);

%% ---------------- Calculo vectorizado (sin loop por punto) ----------
f1 = (-sin(Ax).*sin(Ay)) ./ (cos(Ax)+cos(Ay));
Az = atan(f1);

R11 = cos(Ay).*cos(Az);
R12 = -cos(Ay).*sin(Az);
R21 = cos(Ax).*sin(Az) + cos(Az).*sin(Ax).*sin(Ay);
R22 = cos(Ax).*cos(Az) - sin(Ax).*sin(Ay).*sin(Az);
R31 = sin(Ax).*sin(Az) - cos(Ax).*cos(Az).*sin(Ay);
R32 = cos(Az).*sin(Ax) + cos(Ax).*sin(Ay).*sin(Az);

Ox = (p*(R11-R22))/2;
Oy = -R12*p;

valid_all = true(size(Ax));
theta_all = cell(1,3);
Om_all    = cell(1,3);   % [Ox_m, Oy_m, Oz_m] por pierna

for m = 1:3
    ca = cos(alfa(m)); sa = sin(alfa(m));

    Om_x = Ox + p*ca*R11 + p*sa*R12;
    Om_y = Oy + p*ca*R21 + p*sa*R22;
    Om_z = Zin + p*ca*R31 + p*sa*R32;

    A = 2*l1*ca*(b*ca - Om_x);
    B = 2*l1*Om_z*ca^2;
    C = Om_x.^2 - 2*b*Om_x*ca + ca^2*(b^2 + l1^2 - l2^2) + ca^2*Om_z.^2;

    disc = A.^2 + B.^2 - C.^2;
    okDisc = disc >= 0;

    f_sol = nan(size(Ax));
    f_sol(okDisc) = (C(okDisc) - A(okDisc)) ./ (-B(okDisc) + sqrt(disc(okDisc)));
    Ang1  = 2*atan(f_sol);
    th_m  = -Ang1;
    th_m_deg = rad2deg(th_m);

    okTheta = okDisc & th_m_deg >= theta_min_deg & th_m_deg <= theta_max_deg;

    valid_all = valid_all & okTheta;
    theta_all{m} = th_m_deg;
    Om_all{m}    = cat(4, Om_x, Om_y, Om_z);
end

fprintf('Poses alcanzables: %d de %d (%.1f%%)\n', ...
    nnz(valid_all), numel(valid_all), 100*nnz(valid_all)/numel(valid_all));

roll_v  = rad2deg(Ax(valid_all));
pitch_v = rad2deg(Ay(valid_all));
z_v     = Zin(valid_all);

% Cartesiano real del centro de plataforma (T = [Ox,Oy,Zin])
Xc = Ox(valid_all); Yc = Oy(valid_all); Zc = Zin(valid_all);

%% ---------------- Visualizacion mejorada ----------------

% a) Nube 3D con transparencia 
figure('Color','w','Name','Nube (roll,pitch,Z)');
scatter3(roll_v, pitch_v, z_v, 6, z_v, 'filled', ...
    'MarkerFaceAlpha', 0.15, 'MarkerEdgeAlpha', 0);
colormap(turbo); cb = colorbar; cb.Label.String = 'Z [mm]';
xlabel('Roll [deg]'); ylabel('Pitch [deg]'); zlabel('Z [mm]');
title('Espacio de trabajo alcanzable (transparencia por densidad)');
grid on; view(45,25); axis tight;

% b) Frontera (alphaShape) 
figure('Color','w','Name','Frontera alphaShape');
shp = alphaShape(roll_v, pitch_v, z_v);
shp.Alpha = criticalAlpha(shp,'one-region') * 1.3;  % mas robusto que *1.5 fijo
plot(shp, 'FaceColor', [0.2 0.6 0.9], 'FaceAlpha', 0.4, 'EdgeColor', 'none');
xlabel('Roll [deg]'); ylabel('Pitch [deg]'); zlabel('Z [mm]');
title('Frontera del espacio de trabajo'); grid on; camlight; lighting gouraud;

% c) Cortes 2D por altura
z_unique = unique(z_range);
z_slices = z_unique(round(linspace(1, numel(z_unique), 6)));  % 6 cortes representativos
figure('Color','w','Name','Cortes por altura');
for s = 1:numel(z_slices)
    subplot(2,3,s);
    mask = squeeze(valid_all(:,:,z_range==z_slices(s)));
    imagesc(rad2deg(pitch_range), rad2deg(roll_range), mask);
    set(gca,'YDir','normal'); axis equal tight;
    xlabel('Pitch [deg]'); ylabel('Roll [deg]');
    title(sprintf('Z = %d mm', z_slices(s)));
end
sgtitle('Envolvente roll-pitch alcanzable por altura');

% d) Cartesiano real del centro de plataforma
figure('Color','w','Name','Centro de plataforma (cartesiano)');
scatter3(Xc, Yc, Zc, 6, Zc, 'filled', 'MarkerFaceAlpha', 0.2, 'MarkerEdgeAlpha',0);
colormap(turbo); colorbar;
xlabel('X [mm]'); ylabel('Y [mm]'); zlabel('Z [mm]');
title('Trayectoria posible del centro de plataforma'); axis equal; grid on; view(45,25);
